	local function loadNamedConfig(name)
		if not name or name == "" or name == "None" then return end
		local filePath = "BHubConfig/" .. name .. ".json"
		if isfile and isfile(filePath) then
			local raw = readfile(filePath)
			local success, configData = pcall(function() return HttpService:JSONDecode(raw) end)
			if success and configData then
				isAimbotEnabled = configData.isAimbotEnabled or false
				fovRadius = configData.fovRadius or fovRadius
				smoothSpeed = math.clamp(configData.smoothSpeed or smoothSpeed, 0.01, 1)
				targetPartName = configData.targetPartName or targetPartName
				useTeamCheck = configData.useTeamCheck or false
				useWallCheck = configData.useWallCheck or false
