	local function updateESP()
		local myChar = localPlayer.Character
		local myHRP = myChar and myChar:FindFirstChild("HumanoidRootPart")
		
		for player, line in pairs(tracersTable) do
			if not player or not player.Parent then
				pcall(function() line:Remove() end)
				tracersTable[player] = nil
			end
		end

		for _, player in ipairs(Players:GetPlayers()) do
			if player ~= localPlayer then
				local char = player.Character
				local line = tracersTable[player]
				local box = boxEspTable[player]
				
				if not char or not char.Parent or not char:FindFirstChild("HumanoidRootPart") then
					if line then line.Visible = false end
					if box then for _, l in pairs(box) do l.Visible = false end end
				else
					local head = getUniversalTargetPart(char)
					local hum = char:FindFirstChildOfClass("Humanoid")
					local bgui = head and head:FindFirstChild("BHubESP")
					if bgui and hum then
						local label = bgui:FindFirstChild("ESPLabel")
						local textParts = {}
						if isNameEspEnabled then table.insert(textParts, player.Name) end
						if isDistanceEspEnabled and myHRP and char:FindFirstChild("HumanoidRootPart") then
							local dist = math.floor((char.HumanoidRootPart.Position - myHRP.Position).Magnitude)
							table.insert(textParts, "[" .. dist .. "m]")
						end
						if label then
							label.Text = table.concat(textParts, " ")
							label.Visible = (isNameEspEnabled or isDistanceEspEnabled)
						end
					end
					local highlight = char:FindFirstChild("RedChamsHighlight")
					if isRedChamsEnabled and hum and hum.Health > 0 then
						if not highlight then
							highlight = Instance.new("Highlight")
							highlight.Name = "RedChamsHighlight"
							highlight.FillColor = Color3.fromRGB(255, 0, 0)
							highlight.OutlineColor = Color3.fromRGB(255, 255, 255)
							highlight.FillTransparency = 0.3
							highlight.OutlineTransparency = 0
							highlight.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
							highlight.Adornee = char
							highlight.Parent = char
						end
						highlight.Enabled = true
					else
						if highlight then highlight.Enabled = false end
					end
					if Drawing then
						if not line then
							line = Drawing.new("Line")
							line.Thickness = 1.5
							line.Color = Color3.fromRGB(255, 50, 50)
							line.Transparency = 0.8
							tracersTable[player] = line
						end
						if isTracersEnabled and char:FindFirstChild("HumanoidRootPart") and hum and hum.Health > 0 then
							local hrpPos, onScreen = camera:WorldToViewportPoint(char.HumanoidRootPart.Position)
							if onScreen then
								line.From = Vector2.new(camera.ViewportSize.X / 2, camera.ViewportSize.Y)
								line.To = Vector2.new(hrpPos.X, hrpPos.Y)
								line.Visible = true
							else
								line.Visible = false
							end
						else
							if line then line.Visible = false end
						end

						if not box then
							box = {
								Top = Drawing.new("Line"),
								Bottom = Drawing.new("Line"),
								Left = Drawing.new("Line"),
								Right = Drawing.new("Line")
							}
							for _, l in pairs(box) do
								l.Thickness = 1.5
								l.Color = Color3.fromRGB(255, 255, 255)
								l.Transparency = 0.8
							end
							boxEspTable[player] = box
						end

						if isBoxEspEnabled and char:FindFirstChild("HumanoidRootPart") and hum and hum.Health > 0 then
							local hrp = char.HumanoidRootPart
							local pos, onScreen = camera:WorldToViewportPoint(hrp.Position)
							if onScreen then
								local size = Vector2.new(2500 / pos.Z, 4000 / pos.Z)
								local topLeft = Vector2.new(pos.X - size.X / 2, pos.Y - size.Y / 2)
								local topRight = Vector2.new(pos.X + size.X / 2, pos.Y - size.Y / 2)
								local bottomLeft = Vector2.new(pos.X - size.X / 2, pos.Y + size.Y / 2)
								local bottomRight = Vector2.new(pos.X + size.X / 2, pos.Y + size.Y / 2)

								box.Top.From = topLeft box.Top.To = topRight box.Top.Visible = true
								box.Bottom.From = bottomLeft box.Bottom.To = bottomRight box.Bottom.Visible = true
								box.Left.From = topLeft box.Left.To = bottomLeft box.Left.Visible = true
								box.Right.From = topRight box.Right.To = bottomRight box.Right.Visible = true
							else
								for _, l in pairs(box) do l.Visible = false end
							end
						else
							for _, l in pairs(box) do l.Visible = false end
						end
					end
				end
			end
		end
	end

