local function getAllConfigs()
    local configs = {}
    if isfolder and isfolder("BHubConfig") then
        for _, file in ipairs(listfiles("BHubConfig")) do
            if string.sub(file, -5) == ".json" then
                local name = string.match(file, "BHubConfig[\\/](.+)%.json")
                if name then table.insert(configs, name) end
            end
        end
    end
    if #configs == 0 then table.insert(configs, "None") end
    return configs
end

