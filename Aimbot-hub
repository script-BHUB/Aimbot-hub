local function updateESP()
    local myChar = localPlayer.Character
    local myHRP = myChar and myChar:FindFirstChild("HumanoidRootPart")
    for _, player in ipairs(Players:GetPlayers()) do
        if player ~= localPlayer and player.Character then
            local char = player.Character
            local head = char:FindFirstChild("Head") or char:FindFirstChild("HumanoidRootPart")
            local hum = char:FindFirstChildOfClass("Humanoid")
            local bgui = head and head:FindFirstChild("BHubESP")
            if bgui and hum then
                local label = bgui:FindFirstChild("ESPLabel")
                local textParts = {}
                if isNameEspEnabled then table.insert(textParts, player.Name) end
                if isDistanceEspEnabled and myHRP and char:FindFirstChild("HumanoidRootPart") then
                    local dist = math.floor((char.HumanoidRootPart.Position - myHRP.Position).Magnitude)
                    table.insert(textParts, "[" .. dist .. "m]")
                end
                if label then
                    label.Text = table.concat(textParts, " ")
                    label.Visible = (isNameEspEnabled or isDistanceEspEnabled)
                end
            end
            local highlight = char:FindFirstChild("RedChamsHighlight")
            if isRedChamsEnabled and hum and hum.Health > 0 then
                if not highlight then
                    highlight = Instance.new("Highlight")
                    highlight.Name = "RedChamsHighlight"
                    highlight.FillColor = Color3.fromRGB(255, 0, 0)
                    highlight.OutlineColor = Color3.fromRGB(255, 255, 255)
                    highlight.FillTransparency = 0.3
                    highlight.OutlineTransparency = 0
                    highlight.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
                    highlight.Adornee = char
                    highlight.Parent = char
                end
                highlight.Enabled = true
            else
                if highlight then highlight.Enabled = false end
            end
            if Drawing then
                if not tracersTable[player] then
                    local line = Drawing.new("Line")
                    line.Thickness = 1.5
                    line.Color = Color3.fromRGB(255, 50, 50)
                    line.Transparency = 0.8
                    tracersTable[player] = line
                end
                local line = tracersTable[player]
                if isTracersEnabled and char:FindFirstChild("HumanoidRootPart") and hum and hum.Health > 0 then
                    local hrpPos, onScreen = camera:WorldToViewportPoint(char.HumanoidRootPart.Position)
                    if onScreen then
                        line.From = Vector2.new(camera.ViewportSize.X / 2, camera.ViewportSize.Y)
                        line.To = Vector2.new(hrpPos.X, hrpPos.Y)
                        line.Visible = true
                    else
                        line.Visible = false
                    end
                else
                    line.Visible = false
                end
            end
        end
    end
end

