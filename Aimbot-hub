			selectedConfigToLoad = "None"
			if refreshConfigList then refreshConfigList() end
			WindUI:Notify({ Title = "B Hub", Content = "Deleted Config: " .. name, Duration = 3, Icon = "trash" })
		else
			WindUI:Notify({ Title = "B Hub", Content = "Config File Not Found!", Duration = 3, Icon = "x" })
		end
	end

