-- ==========================================
-- Compact Low Graphics & Texture Remover (Boost fps)
-- ==========================================
local function applyBoostFps(enable)
    pcall(function()
        Lighting.GlobalShadows = not enable
        Lighting.FogEnd = enable and 9e9 or 1000

        -- ปิดเอฟเฟกต์แสงสว่างใน Lighting
        for _, v in ipairs(Lighting:GetChildren()) do
            if v:IsA("PostEffect") or v:IsA("BloomEffect") or v:IsA("BlurEffect") or v:IsA("SunRaysEffect") or v:IsA("DepthOfFieldEffect") or v:IsA("Atmosphere") then
                if v.Name ~= "BHubColorCorrection" then
                    v.Enabled = not enable
                end
            end
        end

        -- ปรับผิวน้ำ Terrain
        local terrain = Workspace:FindFirstChildOfClass("Terrain")
        if terrain then
            terrain.WaterWaveSize = enable and 0 or 0.15
            terrain.WaterWaveSpeed = enable and 0 or 10
            terrain.WaterReflectance = enable and 0 or 1
            terrain.WaterTransparency = enable and 0 or 1
        end

        -- Low Graphics: เปลี่ยนพื้นผิว + ลบ Texture / Particles
        for _, obj in ipairs(Workspace:GetDescendants()) do
            if obj:IsA("BasePart") then
                if enable then
                    obj.Material = Enum.Material.SmoothPlastic
                    obj.CastShadow = false
                end
            elseif obj:IsA("Decal") or obj:IsA("Texture") then
                if enable then obj.Transparency = 1 end
            elseif obj:IsA("ParticleEmitter") or obj:IsA("Trail") or obj:IsA("Smoke") or obj:IsA("Fire") or obj:IsA("Sparkles") then
                if enable then obj.Enabled = false end
            end
        end
    end)
end

