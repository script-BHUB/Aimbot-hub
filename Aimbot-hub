local function enableDragging(buttonObject, onSingleClick)
    local dragging, dragInput, dragStart, startPos
    local isDragging = false
    local threshold = 5
    buttonObject.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            dragging = true
            dragStart = input.Position
            startPos = buttonObject.Position
            isDragging = false
            input.Changed:Connect(function()
                if input.UserInputState == Enum.UserInputState.End then dragging = false end
            end)
        end
    end)
    buttonObject.InputChanged:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch then dragInput = input end
    end)
    UserInputService.InputChanged:Connect(function(input)
        if input == dragInput and dragging then
            local delta = input.Position - dragStart
            if delta.Magnitude > threshold then isDragging = true end
            buttonObject.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + delta.X, startPos.Y.Scale, startPos.Y.Offset + delta.Y)
        end
    end)
    buttonObject.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            if not isDragging and onSingleClick then onSingleClick() end
        end
    end)
end
enableDragging(quickAimButton, function() toggleAimbot() end)
enableDragging(fpsPingLabel, nil)

RunService.RenderStepped:Connect(function()
    updateAimbot()
    updateESP()
    if isFullbrightEnabled or isNoFogEnabled then updateLighting() end
    if isFpsPingVisible then
        frameCount = frameCount + 1
        local now = tick()
        if now - lastFpsUpdate >= 1 then
            currentFps = math.floor(frameCount / (now - lastFpsUpdate))
            frameCount = 0
            lastFpsUpdate = now
            local pingVal = 0
            pcall(function()
                pingVal = math.floor(localPlayer:GetNetworkPing() * 1000)
            end)
            fpsPingLabel.Text = string.format("FPS: %d | Ping: %d ms", currentFps, pingVal)
        end
    end
end)

RunService.Heartbeat:Connect(function()
    local character = localPlayer.Character
    if character and character:FindFirstChild("Humanoid") then
        local humanoid = character.Humanoid
        if isSpeedEnabled and humanoid.WalkSpeed ~= customWalkSpeed then
            humanoid.WalkSpeed = customWalkSpeed
        elseif not isSpeedEnabled and humanoid.WalkSpeed ~= defaultWalkSpeed then
            humanoid.WalkSpeed = defaultWalkSpeed
        end
        if isJumpEnabled and humanoid.JumpPower ~= customJumpPower then
            humanoid.JumpPower = customJumpPower
        elseif not isJumpEnabled and humanoid.JumpPower ~= defaultJumpPower then
            humanoid.JumpPower = defaultJumpPower
        end
    end
end)

