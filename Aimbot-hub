local function loadNamedConfig(name)
    if not name or name == "" or name == "None" then return end
    local filePath = "BHubConfig/" .. name .. ".json"
    if isfile and isfile(filePath) then
        local raw = readfile(filePath)
        local success, configData = pcall(function() return HttpService:JSONDecode(raw) end)
        if success and configData then
            -- โหลดค่าลงตัวแปรหลัก
            isAimbotEnabled = configData.isAimbotEnabled or false
            fovRadius = configData.fovRadius or fovRadius
            smoothSpeed = math.clamp(configData.smoothSpeed or smoothSpeed, 0.01, 1)
            targetPartName = configData.targetPartName or targetPartName
            useTeamCheck = configData.useTeamCheck or false
            useWallCheck = configData.useWallCheck or false
            isFovVisible = configData.isFovVisible ~= false

            if configData.fovColor then
                fovColor = Color3.new(configData.fovColor.R, configData.fovColor.G, configData.fovColor.B)
                if fovStroke then fovStroke.Color = fovColor end
            end

            isRedChamsEnabled = configData.isRedChamsEnabled or false
            isNameEspEnabled = configData.isNameEspEnabled or false
            isDistanceEspEnabled = configData.isDistanceEspEnabled or false
            isTracersEnabled = configData.isTracersEnabled or false
            isFullbrightEnabled = configData.isFullbrightEnabled or false
            isNoFogEnabled = configData.isNoFogEnabled or false

            isSpeedEnabled = configData.isSpeedEnabled or false
            customWalkSpeed = configData.customWalkSpeed or customWalkSpeed
            isJumpEnabled = configData.isJumpEnabled or false
            customJumpPower = configData.customJumpPower or customJumpPower
            if configData.cameraFOV then camera.FieldOfView = configData.cameraFOV end
            isInfJumpEnabled = configData.isInfJumpEnabled or false
            isAntiAfkEnabled = configData.isAntiAfkEnabled or false
            isFlyEnabled = configData.isFlyEnabled or false
            flySpeed = configData.flySpeed or flySpeed
            isNoclipEnabled = configData.isNoclipEnabled or false

            -- อัปเดตการแสดงผลบนหน้าจอ UI ทันที
            setAimbotState(isAimbotEnabled)
            if fovCircle then 
                fovCircle.Visible = isFovVisible 
                fovCircle.Size = UDim2.new(0, fovRadius * 2, 0, fovRadius * 2) 
            end
            updateLighting()

            -- ซิงค์ค่ากลับไปที่ Widget บน UI
            for name, widget in pairs(uiWidgets) do
                if name == "AimbotToggle" then widget:Set(isAimbotEnabled)
                elseif name == "FovToggle" then widget:Set(isFovVisible)
                elseif name == "FovSlider" then widget:Set(fovRadius)
                elseif name == "SmoothSlider" then widget:Set(math.clamp(math.floor(smoothSpeed * 100), 1, 100))
                elseif name == "TeamCheckToggle" then widget:Set(useTeamCheck)
                elseif name == "WallCheckToggle" then widget:Set(useWallCheck)
                elseif name == "RedChamsToggle" then widget:Set(isRedChamsEnabled)
                elseif name == "NameEspToggle" then widget:Set(isNameEspEnabled)
                elseif name == "DistEspToggle" then widget:Set(isDistanceEspEnabled)
                elseif name == "TracersToggle" then widget:Set(isTracersEnabled)
                elseif name == "FullbrightToggle" then widget:Set(isFullbrightEnabled)
                elseif name == "NoFogToggle" then widget:Set(isNoFogEnabled)
                elseif name == "SpeedToggle" then widget:Set(isSpeedEnabled)
                elseif name == "SpeedSlider" then widget:Set(customWalkSpeed)
                elseif name == "JumpToggle" then widget:Set(isJumpEnabled)
                elseif name == "JumpSlider" then widget:Set(customJumpPower)
                elseif name == "CameraFovSlider" then widget:Set(camera.FieldOfView)
                elseif name == "InfJumpToggle" then widget:Set(isInfJumpEnabled)
                elseif name == "AntiAfkToggle" then widget:Set(isAntiAfkEnabled)
                elseif name == "FlyToggle" then widget:Set(isFlyEnabled)
                elseif name == "FlySpeedSlider" then widget:Set(flySpeed)
                elseif name == "NoclipToggle" then widget:Set(isNoclipEnabled)
                end
            end

            WindUI:Notify({ Title = "B Hub", Content = "Loaded Config: " .. name, Duration = 3, Icon = "download" })
        end
    else
        WindUI:Notify({ Title = "B Hub", Content = "Config File Not Found!", Duration = 3, Icon = "x" })
    end
end

local function deleteNamedConfig(name)
    if not name or name == "" or name == "None" then return end
    local filePath = "BHubConfig/" .. name .. ".json"
    if isfile and isfile(filePath) then
        delfile(filePath)
        selectedConfigToLoad = "None"
        if refreshConfigList then refreshConfigList() end
        WindUI:Notify({ Title = "B Hub", Content = "Deleted Config: " .. name, Duration = 3, Icon = "trash" })
    else
        WindUI:Notify({ Title = "B Hub", Content = "Config File Not Found!", Duration = 3, Icon = "x" })
    end
end

